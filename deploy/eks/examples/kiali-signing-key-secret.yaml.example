# Template only. Signs Kiali login tokens; deploy/eks/helm-values/kiali.yaml reads it as secret:kiali-signing-key:key.
# Prefer the `kubectl create secret` command in deploy/eks/DEPLOY.md, which leaves no file behind. Never commit a filled-in copy.
apiVersion: v1
kind: Secret
metadata:
  name: kiali-signing-key
  namespace: istio-system
type: Opaque
stringData:
  key: REPLACE_ME
