# Template only. Alloy mounts this and authenticates to mk4 as user "eks"; the same password must be set in the Secret of
# this name in monitoring on mk4. Prefer the commands in deploy/eks/DEPLOY.md. Never commit a filled-in copy.
apiVersion: v1
kind: Secret
metadata:
  name: loki-push-auth
  namespace: monitoring
type: Opaque
stringData:
  password: REPLACE_ME
