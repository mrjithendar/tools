# Template only. Used by the letsencrypt-* ClusterIssuers for DNS-01. Needs Zone -> DNS -> Edit and Zone -> Zone -> Read on the zone.
# Prefer the `kubectl create secret` command in deploy/eks/DEPLOY.md, which leaves no file behind. Never commit a filled-in copy.
apiVersion: v1
kind: Secret
metadata:
  name: cloudflare-api-token
  namespace: cert-manager
type: Opaque
stringData:
  api-token: REPLACE_ME
